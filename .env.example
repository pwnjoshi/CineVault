# Reelfind Environment Variables Configuration

# Port for backend server
PORT=4000

# Parallel API Configuration (https://platform.parallel.ai/)
PARALLEL_API_KEY=your_parallel_api_key_here
PARALLEL_BASE_URL=https://api.parallel.ai/v1

# Google Cloud / Gemini Enterprise / Agent Builder Configuration
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
# If using Vertex AI Agent Builder / Discovery Engine:
GOOGLE_AGENT_APP_ID=your_agent_app_id_or_data_store_id
# Optional: Path to GCP service account JSON key file (if not using application-default credentials)
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Gemini Direct API Key (Vertex AI or AI Studio)
GEMINI_API_KEY=

# Server Environment
NODE_ENV=development
